{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "online-v2-probe-release",
      "inherits": "online-v2-release",
      "binaryDir": "${sourceDir}/build-online-v2-probe",
      "cacheVariables": { "CTR_ONLINE_PROBES": "ON" }
    },
    {
      "name": "web-probe-release",
      "inherits": "web-release",
      "binaryDir": "${sourceDir}/build-web-probe",
      "cacheVariables": { "CTR_ONLINE_PROBES": "ON" }
    },
    {
      "name": "online-v2-release",
      "displayName": "Online 2.0 headless simulation prototype",
      "inherits": "web-release",
      "binaryDir": "${sourceDir}/build-online-v2",
      "cacheVariables": { "CTR_HEADLESS": "ON" }
    },
    {
      "name": "web-release",
      "displayName": "Browser (WebAssembly / WebGL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "common",
      "hidden": true,
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc-x86",
      "displayName": "Windows MSVC x86",
      "description": "Native 32-bit Windows build using an installed Visual Studio 2022 or newer",
      "inherits": "common",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build-msvc-x86",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio"
        }
      }
    },
    {
      "name": "windows-mingw-i686-debug",
      "displayName": "Windows MinGW i686 Debug",
      "inherits": "common",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-mingw-i686-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW"
        }
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "i686-w64-mingw32-gcc",
        "CMAKE_MAKE_PROGRAM": "mingw32-make"
      }
    },
    {
      "name": "windows-mingw-i686-release",
      "displayName": "Windows MinGW i686 Release",
      "inherits": "common",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-mingw-i686-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW"
        }
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "i686-w64-mingw32-gcc",
        "CMAKE_MAKE_PROGRAM": "mingw32-make"
      }
    },
    {
      "name": "linux-gcc-i686-debug",
      "displayName": "Linux GCC i686 Debug",
      "inherits": "common",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-linux-gcc-i686-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32"
      }
    },
    {
      "name": "linux-gcc-i686-release",
      "displayName": "Linux GCC i686 Release",
      "inherits": "common",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-linux-gcc-i686-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_EXE_LINKER_FLAGS": "-m32"
      }
    }
  ],
  "buildPresets": [
    { "name": "online-v2-probe-release", "configurePreset": "online-v2-probe-release", "targets": ["ctr_native"] },
    { "name": "web-probe-release", "configurePreset": "web-probe-release", "targets": ["ctr_native"] },
    { "name": "online-v2-release", "configurePreset": "online-v2-release", "targets": ["ctr_native"] },
    {
      "name": "web-release",
      "configurePreset": "web-release",
      "targets": [
        "ctr_native"
      ]
    },
    {
      "name": "windows-msvc-x86-debug",
      "configurePreset": "windows-msvc-x86",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-x86-release",
      "configurePreset": "windows-msvc-x86",
      "configuration": "Release"
    },
    {
      "name": "windows-mingw-i686-debug",
      "configurePreset": "windows-mingw-i686-debug"
    },
    {
      "name": "windows-mingw-i686-release",
      "configurePreset": "windows-mingw-i686-release"
    },
    {
      "name": "linux-gcc-i686-debug",
      "configurePreset": "linux-gcc-i686-debug"
    },
    {
      "name": "linux-gcc-i686-release",
      "configurePreset": "linux-gcc-i686-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-x86-debug",
      "configurePreset": "windows-msvc-x86",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-x86-release",
      "configurePreset": "windows-msvc-x86",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mingw-i686-debug",
      "configurePreset": "windows-mingw-i686-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mingw-i686-release",
      "configurePreset": "windows-mingw-i686-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-i686-debug",
      "configurePreset": "linux-gcc-i686-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-i686-release",
      "configurePreset": "linux-gcc-i686-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
